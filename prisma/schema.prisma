// ElectroBolívar — fictional home-appliance store demo (portfolio project).
// Prices are stored as whole-peso Int (ARS has no meaningful cents in
// casual display), matching the other -demo projects in this portfolio.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Product {
  id           String         @id @default(cuid())
  name         String
  category     String
  price        Int
  installments String?
  inStock      Boolean        @default(true)
  description  String?
  videoUrl     String?
  images       ProductImage[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  order     Int     @default(0)
}

// Singleton row (id is always "singleton") holding store-wide settings —
// just the WhatsApp number today, easy to extend later.
model StoreSettings {
  id       String  @id @default("singleton")
  whatsapp String?
}

// Rotating ad banners (e.g. the sponsor's promo), managed from the admin
// settings screen. Each entry ships two images because the mobile bottom
// bar and the desktop sidebar are different fixed shapes (wide banner vs.
// tall 9:16 panel) — one crop never looks right in both.
model PromoImage {
  id         String   @id @default(cuid())
  mobileUrl  String
  desktopUrl String
  alt        String
  order      Int      @default(0)
  createdAt  DateTime @default(now())
}

// Shopper accounts (separate from the admin/client role switcher, which is
// just a localStorage toggle). Standard Auth.js Prisma adapter shape, plus
// a `password` hash on User for the email/password credentials login —
// null for accounts created via Google only.
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  province      String?
  locality      String?
  address       String?
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
