DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require&channel_binding=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require"
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Required. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="..."
# Set to the deployed URL (e.g. https://mercadobolivar.tomasarras.com.ar)
NEXTAUTH_URL="http://localhost:3000"

# Optional — "Continuar con Google" only appears on /login once both are set.
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# with authorized redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Required for "Pagar con Mercado Pago" in the cart. Use a TEST- access token
# (sandbox) from https://www.mercadopago.com.ar/developers/panel/app — found
# under your app → "Credenciales de prueba". A TEST- token automatically
# sends shoppers to the sandbox checkout instead of the live one.
MP_ACCESS_TOKEN=""

# Required for "Buscar por foto" en el buscador del header. Generá una key en
# https://console.anthropic.com/settings/keys — se usa para que Claude
# describa el producto de la foto y buscarlo en el catálogo.
ANTHROPIC_API_KEY=""
