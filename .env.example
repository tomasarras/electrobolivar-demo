DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require&channel_binding=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require"
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Required. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="..."
# Set to the deployed URL (e.g. https://electrobolivar.tomasarras.com.ar)
NEXTAUTH_URL="http://localhost:3000"

# Optional — "Continuar con Google" only appears on /login once both are set.
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# with authorized redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
