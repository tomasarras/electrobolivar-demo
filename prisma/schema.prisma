// MercadoBolívar — fictional home-appliance store demo (portfolio project).
// Prices are stored as whole-peso Int (ARS has no meaningful cents in
// casual display), matching the other -demo projects in this portfolio.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Product {
  id           String         @id @default(cuid())
  name         String
  category     String
  price        Int
  // "ARS" | "USD" — plain string rather than an enum, matching condition/category.
  currency     String         @default("ARS")
  installments String?
  // "10" | "20" | "30" | "50" (percent, opcional).
  discountPct    String?
  // "semana" | "mes" | "siempre" — duración del descuento.
  discountPeriod String?
  // "nuevo" | "usado" — plain string rather than an enum so it matches the
  // rest of the schema's style (category is a plain string too).
  condition    String         @default("nuevo")
  stock        Int            @default(0)
  shipping     Boolean        @default(true)
  // null = no free-shipping offer, 0 = always free, N = free above $N.
  freeShippingMinAmount Int?
  scheduleDays   String?
  scheduleHours  String?
  scheduleHours2 String?
  // Ciudad o zona del producto, para todas las categorías — así el
  // comprador puede ver si es de su ciudad antes de contactar.
  location       String?
  // Only used for category "vehiculos".
  vehicleCategory String?
  vehicleYear  Int?
  vehicleKm    Int?
  vehicleBrand String?
  vehicleModel String?
  vehicleColor String?
  // Only used for category "inmobiliaria". "alquiler" | "venta".
  propertyCategory    String?
  propertyOperation   String?
  propertyCoveredArea Int?
  propertyTotalArea   Int?
  propertyBedrooms    Int?
  propertyRooms       Int?
  propertyBathrooms   Int?
  propertyTotalUnits  Int?
  propertyLocation    String?
  // Only used for category "cocina" (Tecnología) when techCategory is "Celulares".
  phoneBrand   String?
  phoneModel   String?
  phoneStorage String?
  phoneRam     String?
  phoneNetwork String?
  phoneColor   String?
  phoneCamera  String?
  // Only used for category "ropa".
  clothingCategory    String?
  clothingAccessories String?
  clothingGender      String?
  clothingSize        String?
  clothingBrand       String?
  clothingColor       String?
  clothingFit         String?
  clothingAge         String?
  clothingMaterial    String?
  clothingSleeve      String?
  clothingNeckline    String?
  // Only used for category "pequenos" (Belleza).
  beautyCategory String?
  beautyBrand    String?
  // Only used for category "cocina" (Tecnología).
  techCategory String?
  techBrand    String?
  techColor    String?
  // Only used for category "herramientas".
  toolsCategory String?
  // Only used for category "climatizacion" (Hogar). homeSaleFormat: "Unidad" | "Pack".
  homeCategory   String?
  homeColor      String?
  homeBrand      String?
  homeSaleFormat String?
  // Only used for category "lavado" (Electro).
  laundryCategory String?
  laundryBrand    String?
  laundryColor    String?
  // Global favorite count across all visitors. Favorites aren't tied to user
  // accounts (tracked client-side in localStorage), so this is a simple
  // incremented/decremented counter rather than a per-user join table.
  favoriteCount Int @default(0)
  description  String?
  videoUrl     String?
  images       ProductImage[]
  specs        ProductSpec[]
  // Null seller = house product, sold by the store itself (as before sellers existed).
  sellerId     String?
  seller       Seller?        @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  orderItems   OrderItem[]
  reviews      Review[]
  deliveryPhotos DeliveryPhoto[]
  messages     Message[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

// Free-form spec sheet rows (e.g. "Potencia" → "650W"), ordered as entered.
// A separate table rather than a Json column so it matches the ProductImage
// pattern already used for other repeatable per-product data.
model ProductSpec {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  label     String
  value     String
  order     Int     @default(0)
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  order     Int     @default(0)
}

// Singleton row (id is always "singleton") holding store-wide settings —
// WhatsApp number, plus the commission percentage charged to marketplace
// sellers on every sale.
model StoreSettings {
  id            String  @id @default("singleton")
  whatsapp      String?
  commissionPct Int     @default(10)
}

// Rotating ad banners (e.g. the sponsor's promo), managed from the admin
// settings screen. Each entry ships two images because the mobile bottom
// bar and the desktop sidebar are different fixed shapes (wide banner vs.
// tall 9:16 panel) — one crop never looks right in both.
model PromoImage {
  id         String   @id @default(cuid())
  mobileUrl  String
  desktopUrl String
  alt        String
  order      Int      @default(0)
  createdAt  DateTime @default(now())
}

// Shopper accounts (separate from the admin/client role switcher, which is
// just a localStorage toggle). Standard Auth.js Prisma adapter shape, plus
// a `password` hash on User for the email/password credentials login —
// null for accounts created via Google only.
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  province      String?
  locality      String?
  address       String?
  phone         String?
  accounts      Account[]
  sessions      Session[]
  seller        Seller?
  orders        Order[]
  reviews       Review[]
  deliveryPhotos DeliveryPhoto[]
  chatMessages  ChatMessage[]
  createdAt     DateTime  @default(now())
}

// A buyer who opted to also sell on the marketplace. Self-service, no
// approval step: creating this row is what makes someone a seller.
model Seller {
  id            String         @id @default(cuid())
  userId        String         @unique
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeName     String
  whatsapp      String?
  // Where the seller wants their sales payouts sent — set by the seller
  // themselves, never shown to buyers.
  payoutBank        String?
  payoutHolderName  String?
  payoutHolderDni   String?
  payoutCbu         String?
  payoutAlias       String?
  // Manual admin flag — not automatic — for sellers worth a closer look,
  // typically after receiving a complaint. Shown as a warning on their
  // public profile.
  flaggedFraud  Boolean        @default(false)
  // Shown once on the seller's first visit, reminding them to fill out
  // payout data before publishing. Dismissed permanently after "Entendido".
  sawPayoutNotice Boolean      @default(false)
  products      Product[]
  orderItems    OrderItem[]
  notifications Notification[]
  chatMessages  ChatMessage[]
  createdAt     DateTime       @default(now())
}

// A direct message between a buyer and a seller — surfaced on the buyer's
// "Mi perfil > Mensajes" and the seller's "Consultas" tab. Grouped into a
// thread by the (buyerId, sellerId) pair rather than a separate
// conversation table, since each buyer has at most one thread per seller.
model ChatMessage {
  id        String   @id @default(cuid())
  buyerId   String
  buyer     User     @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId  String
  seller    Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  // "buyer" | "seller" — who sent this message.
  sender    String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([buyerId, sellerId])
}

// "You made a sale" alerts for the seller panel — created alongside the
// OrderItem at checkout, read/unread so the panel can show a badge count.
model Notification {
  id        String   @id @default(cuid())
  sellerId  String
  seller    Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// A completed checkout, persisted so sales can be attributed to a seller
// and commission tracked. Created from the cart at confirmation time —
// there's no separate payment-gateway webhook, since only Mercado Pago is
// wired up for real (and only in sandbox mode); every other method here is
// already a simulated "instant confirm".
model Order {
  id             String      @id @default(cuid())
  code           String      @unique
  buyerId        String?
  buyer          User?       @relation(fields: [buyerId], references: [id], onDelete: SetNull)
  paymentMethod  String
  deliveryMethod String
  address        String?
  contactPhone   String?
  // Free-text note from the buyer for whoever fulfills the order (e.g. "after
  // 2pm I'll be home"), shown alongside the order wherever it's fulfilled.
  deliveryNote   String?
  total          Int
  items          OrderItem[]
  notifications  Notification[]
  createdAt      DateTime    @default(now())
}

// Line item snapshot: price, seller and commission are captured at sale
// time so later catalog/price/commission changes don't rewrite history.
model OrderItem {
  id            String   @id @default(cuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String?
  product       Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName   String
  unitPrice     Int
  // Snapshot of the product's currency at sale time ("ARS" | "USD") — needed
  // to total commission income per currency in the admin wallet.
  currency      String   @default("ARS")
  qty           Int
  sellerId      String?
  seller        Seller?  @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  commissionPct Int
  commissionAmt Int
  review        Review?
  deliveryPhotos DeliveryPhoto[]
}

// A buyer's rating/comment for one purchased line item. Tied to the
// OrderItem (not just the product) so only an actual purchase can be
// reviewed, and at most once per line.
model Review {
  id          String    @id @default(cuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItemId String    @unique
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  buyerId     String?
  buyer       User?     @relation(fields: [buyerId], references: [id], onDelete: SetNull)
  buyerName   String?
  rating      Int
  comment     String?
  createdAt   DateTime  @default(now())
}

// Photos a buyer optionally posts on the product page showing how their
// order actually arrived — independent of the star-rating Review, so a
// buyer can share photos without being forced to also write a review.
model DeliveryPhoto {
  id          String    @id @default(cuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  buyerId     String?
  buyer       User?     @relation(fields: [buyerId], references: [id], onDelete: SetNull)
  buyerName   String?
  url         String
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// One row per browser session (deduped client-side via sessionStorage) —
// just enough to show the admin a mobile-vs-desktop split, not full analytics.
model Visit {
  id        String   @id @default(cuid())
  device    String
  createdAt DateTime @default(now())
}

// A complaint or question a shopper leaves about a product, surfaced to the
// admin in the "Mensajes" panel. Not tied to a purchase or account — anyone
// on the product page can leave one, so productName is a snapshot in case
// the product is later deleted.
model Message {
  id          String   @id @default(cuid())
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String?
  // "producto" | "vendedor" — what the complaint/question is about.
  about       String   @default("producto")
  name        String?
  body        String
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
}
